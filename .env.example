# Copia este archivo a .env.local y completa los valores reales.
# .env.local nunca se sube al repositorio (ver .gitignore).

# Panel del proyecto en Supabase → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key-publica

# Server-only. NUNCA debe llevar el prefijo NEXT_PUBLIC_ ni usarse en
# código de cliente — bypasea RLS por completo. Solo para la operación
# puntual de servidor que de verdad lo necesite (ver documento de
# arquitectura, Fase 1, §9).
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key

# Opcional. Origen absoluto del sitio para los enlaces de los correos de
# Supabase Auth (recuperar contraseña). Sin esta variable se deriva de los
# headers de la request — solo hace falta fijarla en producción detrás de
# un proxy/CDN que oculte el host real.
NEXT_PUBLIC_SITE_URL=https://inspirachurch.com

# Cloudflare Turnstile (dashboard.cloudflare.com → Turnstile → Add site).
# Opcional en desarrollo: sin estas dos variables, los formularios públicos
# siguen funcionando pero sin verificación anti-bot (Fase 12).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=tu-turnstile-site-key
TURNSTILE_SECRET_KEY=tu-turnstile-secret-key

# YouTube Data API v3 (console.cloud.google.com → habilitar "YouTube Data API
# v3" → Credenciales → Crear clave de API). Server-only. Opcional: sin esta
# variable, la sección "En vivo" de Inicio simplemente no aparece nunca.
YOUTUBE_API_KEY=tu-youtube-api-key
